EXPO_PUBLIC_USE_MOCK=true
# Sur un téléphone physique, remplace localhost par l'adresse IPv4 du PC sur le même Wi-Fi.
EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
# Variables lues par app.config.ts lors d'une compilation native.
GOOGLE_MAPS_API_KEY=replace-with-android-maps-sdk-key
GOOGLE_SERVICES_JSON=./google-services.json
