DATABASE_URL="postgresql://postgres:postgres@localhost:5432/covoiturage?schema=public"
PORT=3000
# Obligatoire partout. Générez une valeur unique, par exemple :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Le serveur refuse de démarrer sans secret ou avec une valeur d'exemple.
JWT_SECRET=""
# development en local. Absent ou autre valeur = production : codes OTP fixes refusés.
NODE_ENV="development"
# Développement local uniquement : fixe le code OTP de tous les numéros.
# Le serveur refuse de démarrer si cette variable est définie hors development ou test.
DEV_OTP_CODE="123456"
# Derrière un proxy (Render, Nginx…) : true, ou les adresses du proxy. Sinon, laisser vide.
TRUST_PROXY=""
# Envoi des codes de connexion par SMS (Twilio). Obligatoire hors développement.
# Les trois valeurs se trouvent dans la console Twilio ; TWILIO_FROM est un numéro Twilio
# (+1…) ou un nom d'expéditeur autorisé pour le Cameroun. Ne les partagez jamais.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
# Comptes de test (facultatif) : ces numéros se connectent avec TEST_OTP_CODE, sans SMS.
# Utile tant qu'aucun fournisseur SMS n'est branché : en production sans Twilio, seuls ces
# numéros peuvent se connecter. 5 numéros au maximum, au format international, séparés par des virgules.
# Le code : 6 chiffres secrets, sans suite évidente (123456, 000000… sont refusés). Ne le partagez pas.
TEST_OTP_PHONES=""
TEST_OTP_CODE=""
