DATABASE_URL="postgresql://postgres:postgres@localhost:5432/covoiturage?schema=public"
PORT=3000
# Obligatoire partout. Générez une valeur unique, par exemple :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Le serveur refuse de démarrer sans secret ou avec une valeur d'exemple.
JWT_SECRET=""
# development en local. Absent ou autre valeur = production : codes OTP fixes refusés.
NODE_ENV="development"
# Développement local uniquement : fixe le code OTP de tous les numéros.
# Le serveur refuse de démarrer si cette variable est définie hors development ou test.
DEV_OTP_CODE="123456"
